{
  "name": "nextjs-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "typecheck:watch": "tsgo --noEmit --watch",
    "test:visual": "bash tests/visual/docker/run.sh",
    "test:visual:update": "bash tests/visual/docker/run.sh --update-snapshots=changed",
    "pre-commit-check": "oxlint . && oxfmt --check . && tsgo --noEmit"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.21.5",
    "@hookform/resolvers": "^6.0.1",
    "@next/third-parties": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "caniuse-lite": "^1.0.30001819",
    "classnames": "^2.3.2",
    "date-fns": "^4.4.0",
    "next": "^16.4.3",
    "next-themes": "^0.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260112.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "not ie 11"
  ],
  "prettier": {
    "arrowParens": "always",
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.8.2"
}
